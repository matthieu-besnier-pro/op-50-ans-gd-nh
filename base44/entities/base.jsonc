{
  "name": "base",
  "type": "object",
  "properties": {
    "nom": {
      "type": "string",
      "description": "Nom du site"
    },
    "zone": {
      "type": "string",
      "enum": [
        "Centre",
        "Ouest"
      ],
      "description": "Zone g\u00e9ographique"
    },
    "entite": {
      "type": "string",
      "enum": [
        "DBS",
        "Quitte",
        "Gonnin Duris"
      ],
      "description": "Entit\u00e9 juridique"
    },
    "responsable_id": {
      "type": "string",
      "description": "Responsable commercial du site (User)"
    }
  },
  "required": [
    "nom"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "app_role": "direction"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "app_role": "direction"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "app_role": "direction"
          }
        }
      ]
    }
  }
}
