{
  "name": "base",
  "type": "object",
  "properties": {
    "nom": {
      "type": "string",
      "description": "Nom du site (atelier)"
    },
    "zone": {
      "type": "string",
      "enum": [
        "Centre",
        "Ouest"
      ],
      "description": "Zone g\u00e9ographique"
    },
    "entite": {
      "type": "string",
      "enum": [
        "DBS",
        "Quitte",
        "Gonnin Duris"
      ],
      "description": "Entit\u00e9 juridique"
    },
    "responsable_id": {
      "type": "string",
      "description": "Responsable commercial du site (User)"
    },
    "chefs_atelier": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Chef(s) d'atelier du site"
    },
    "responsables_sav": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Responsable(s) SAV du site"
    },
    "commerciaux": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Commerciaux rattach\u00e9s au site (tableau de r\u00e9partition commerciaux \u00d7 ateliers)"
    }
  },
  "required": [
    "nom"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "app_role": "direction"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "app_role": "direction"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "app_role": "direction"
          }
        }
      ]
    }
  }
}