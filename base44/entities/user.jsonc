{
  "name": "user",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user",
      "description": "Rôle plateforme (admin = Direction/Marketing)"
    },
    "app_role": {
      "type": "string",
      "enum": [
        "commercial",
        "agri_precision",
        "commercial_chef_atelier",
        "responsable",
        "chef_atelier",
        "responsable_sav",
        "direction",
        "collaborateur"
      ],
      "default": "collaborateur",
      "enumNames": [
        "Commercial",
        "Agriculture de précision",
        "Chef d'atelier + Commercial",
        "Responsable commercial",
        "Chef d'atelier",
        "Responsable SAV",
        "Direction / Marketing",
        "Collaborateur"
      ],
      "description": "Fonction dans l'opération"
    },
    "base_id": {
      "type": "string",
      "description": "Base de rattachement (rôle Commercial)"
    },
    "app_role_secondaire": {
      "type": "string",
      "enum": [
        "",
        "agri_precision",
        "responsable_sav",
        "chef_atelier",
        "responsable",
        "commercial"
      ],
      "enumNames": [
        "—",
        "Agriculture de précision",
        "Responsable SAV",
        "Chef d'atelier",
        "Responsable commercial",
        "Commercial"
      ],
      "description": "Seconde casquette : la fonction qu'on exerce EN PLUS de son rôle principal. Elle ouvre une seconde équipe, sans changer les droits."
    }
  }
}
