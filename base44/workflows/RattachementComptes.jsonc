{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "rattachement_comptes",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "rattacher_compte": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "rattacher_comptes",
            "args": {
              "user_id": "${ .trigger.user_id }",
              "email": "${ .trigger.email }",
              "auth_method": "${ .trigger.auth_method }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Rattacher le compte",
            "description": "Fiche, clients et parc"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "app_user_auth",
      "events": [
        "signup",
        "login"
      ]
    }
  },
  "description": "\u00c0 chaque connexion (Google ou identifiant / mot de passe), relie le compte \u00e0 sa fiche commerciale, \u00e0 son portefeuille clients et \u00e0 son parc mat\u00e9riel. Sans effet si le compte est d\u00e9j\u00e0 rattach\u00e9.",
  "name": "Rattachement automatique des comptes"
}